# Copia este archivo a .env y rellena tus claves para ejecutar en local
# (Si despliegas en GitHub, puedes configurar las claves en GitHub Secrets o en el panel de ajustes del juego)
GROQ_API_KEY=tu_clave_de_groq_aqui
GEMINI_API_KEY=tu_clave_de_gemini_aqui
OPENROUTER_API_KEY=tu_clave_de_openrouter_aqui
DEFAULT_PROVIDER=groq
DEFAULT_GROQ_MODEL=llama-3.3-70b-versatile
DEFAULT_GEMINI_MODEL=gemini-2.5-flash
PORT=8090
